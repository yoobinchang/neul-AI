# Variable NAMES only. Real values live in the team's shared secret store, never in Git.
# Exact names may change in the stack-initialization PR.

# Supabase (A)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only; never expose to the app

# Twilio (A)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NEUL_NUMBER=

# Voice platform and AI model (B) - Vapi or Retell (D04), model (D05) chosen in Week 1
VAPI_API_KEY=
VAPI_MODEL=                       # optional; default claude-haiku-5-5
VAPI_VOICE_PROVIDER=              # optional; default vapi
VAPI_VOICE_ID=                    # optional; default Clara
RETELL_API_KEY=
RETELL_MODEL=                     # optional; default claude-5.5-haiku
RETELL_VOICE_ID=                  # optional; default retell-Cimo
ANTHROPIC_API_KEY=                # model comparison (voice/eval)

# Web push (A sends, C subscribes)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only
