# Variable NAMES only. Real values live in the team's shared secret store, never in Git.
# Exact names may change in the stack-initialization PR.

# Supabase (A)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only; never expose to the app

# Twilio (A)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NEUL_NUMBER=

# Voice platform and AI model (B) - Vapi or Retell (D04), model (D05) chosen in Week 1
VAPI_API_KEY=
VAPI_MODEL=                       # optional; default claude-haiku-5-5
VAPI_VOICE_PROVIDER=              # optional; default vapi
VAPI_VOICE_ID=                    # optional; default Clara
RETELL_API_KEY=
RETELL_MODEL=                     # optional; default claude-5.5-haiku
RETELL_VOICE_ID=                  # optional; default retell-Cimo
ANTHROPIC_API_KEY=                # evals locally; also a brain function secret (summaries)
RETELL_LLM_ID=                    # the live agent's LLM, for npm run update:retell
RETELL_AGENT_ID=                  # the live agent; update:retell sets its call_ended webhook and publishes it
RETELL_PHONE_NUMBER=              # optional; update:retell sets its inbound webhook and pins the published version
NEUL_BRAIN_URL=                   # https://<project>.supabase.co/functions/v1/brain
BRAIN_SECRET=                     # brain function secret; A's summary trigger sends it as X-Brain-Secret

# Web push (A sends, C subscribes)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only
