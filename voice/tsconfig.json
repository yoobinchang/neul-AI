{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    // brain/ files import each other as ./x.ts, which Supabase's Deno runtime needs.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    // The brain function lives in supabase/ (Deno maps these in deno.json);
    // locally it resolves them from this package's node_modules.
    "paths": {
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "@anthropic-ai/sdk/*": ["./node_modules/@anthropic-ai/sdk/*"],
      "zod": ["./node_modules/zod"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["src", "scripts", "eval", "../tests/brain", "../supabase/functions/brain"],
  // index.ts is the Deno entry point (Deno.serve); everything it calls is checked here.
  "exclude": ["../supabase/functions/brain/index.ts"]
}
